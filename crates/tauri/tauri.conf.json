{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "horatio-scaffold",
  "version": "0.1.0",
  "identifier": "com.scaffold.app",
  "build": {
    "beforeDevCommand": "pnpm --filter app dev:tauri",
    "beforeBuildCommand": "pnpm --filter app build:tauri",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../apps/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Horatio Scaffold",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
